--------------------------------------------------
-- PLAYER EVENTS
--------------------------------------------------

local function setupPlayer(targetPlayer)

    if targetPlayer == player then
        return
    end

    targetPlayer.CharacterAdded:Connect(
        function()

            task.wait(0.5)

            updateESP()

        end
    )

    targetPlayer:GetPropertyChangedSignal(
        "Team"
    ):Connect(function()

        updateESP()

    end)

end

Players.PlayerAdded:Connect(
    setupPlayer
)

Players.PlayerRemoving:Connect(
    function(targetPlayer)

        removeESP(
            targetPlayer
        )

    end
)

for _, targetPlayer in
    ipairs(Players:GetPlayers()) do

    setupPlayer(
        targetPlayer
    )

end

